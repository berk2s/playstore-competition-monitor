NODE_ENV=development
LOG_LEVEL=info

MONGO_URI=mongodb://localhost:27017/playstore_competition_monitor
REDIS_URL=redis://localhost:6379

CAPTURE_CRON=0 * * * *
CAPTURE_CONCURRENCY=2
CAPTURE_MAX_ATTEMPTS=3

STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
PUBLIC_ASSET_BASE_URL=http://localhost:4000/screenshots

S3_BUCKET=
S3_REGION=us-east-1

CAPTURE_LOCALE=en
CAPTURE_COUNTRY=US
CAPTURE_VIEWPORT_WIDTH=1280
CAPTURE_VIEWPORT_HEIGHT=800
CAPTURE_TIMEOUT_MS=45000
