# ---- Shared ----
NODE_ENV=development
LOG_LEVEL=info

# ---- MongoDB ----
MONGO_URI=mongodb://localhost:27017/competition_monitor

# ---- Redis (BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- API service ----
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# ---- Worker service ----
# How often the dispatcher enqueues a capture for every tracked app (cron)
CAPTURE_CRON=0 * * * *
# Max concurrent Playwright captures
CAPTURE_CONCURRENCY=2
# Per-capture retry attempts
CAPTURE_MAX_ATTEMPTS=3

# ---- Screenshot storage ----
# driver = local | s3
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# Public base URL the web app uses to load images (local dev = API static mount)
PUBLIC_ASSET_BASE_URL=http://localhost:4000/screenshots

# ---- S3 (prod) ----
S3_BUCKET=
S3_REGION=us-east-1
# AWS credentials come from the environment / instance role in prod

# ---- Web ----
VITE_API_BASE_URL=http://localhost:4000
